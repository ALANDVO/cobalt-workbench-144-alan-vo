# Application
ENVIRONMENT=development
VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak / OIDC (configure for production)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Demo mode - binds to localhost only, refuses in production
DEMO_MODE=true

# LLM Providers (optional, server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=